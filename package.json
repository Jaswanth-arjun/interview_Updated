{
  "name": "interview-practice-assistant",
  "version": "1.0.0",
  "description": "On-screen interview practice assistant for mock interviews",
  "author": "Jaswanth Arjun",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "node scripts/dist.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.5",
    "koffi": "^3.1.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.interview.copilot",
    "productName": "Interview Copilot",
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "nsis",
      "executableName": "RuntimeBroker"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!landing/**/*",
      "!server/**/*",
      "!tests/**/*",
      "!dist/**/*",
      "!release/**/*",
      "!scripts/**/*"
    ]
  }
}
